# Required in production. Generate and store this value in the hosting
# provider's protected environment settings; do not commit the value.
OMNILAB_DJANGO_SECRET_KEY=

# Public host names accepted by Django, separated by commas. The current
# Render host remains the fallback when this is empty.
OMNILAB_ALLOWED_HOSTS=omnilab-bk8q.onrender.com

# HTTPS origin used by canonical tags, social metadata, sitemap and robots
# URLs, and prepared-demo links. Do not include a path or trailing slash.
OMNILAB_PUBLIC_ORIGIN=https://omnilab-bk8q.onrender.com

# Set to true only on temporary or preview deployments that must stay out of
# search results. Production remains indexable when this is empty or false.
OMNILAB_NOINDEX=false

# Optional persistent paths used by the one-command deployment package.
# They default to .deploy/data/db.sqlite3, a reaction-rate-limits.sqlite3 file
# beside it, and .deploy/staticfiles.
OMNILAB_DATABASE_PATH=
OMNILAB_REACTION_RATE_LIMIT_DATABASE_PATH=
OMNILAB_STATIC_ROOT=

# Optional process settings. The deployment command defaults to port 8000,
# two Gunicorn workers, and a 30-second worker timeout.
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=30

# Groq chat credential. Set this only in protected environment settings.
GROQ_API_KEY=

# Optional anonymous reaction-analysis limits. Defaults allow 60 analyses from
# one network address in each 10-minute window.
OMNILAB_REACTION_RATE_LIMIT_REQUESTS=60
OMNILAB_REACTION_RATE_LIMIT_WINDOW_SECONDS=600

# SMTP delivery for the in-page contact form. Use the credentials for the
# mailbox that is allowed to send as OMNILAB_CONTACT_FROM_EMAIL.
OMNILAB_EMAIL_HOST=smtp.example.com
OMNILAB_EMAIL_PORT=587
OMNILAB_EMAIL_HOST_USER=your_smtp_username
OMNILAB_EMAIL_HOST_PASSWORD=your_smtp_password
OMNILAB_EMAIL_USE_TLS=true
# Use SSL instead of TLS for providers that require implicit SSL, usually on
# port 465. Keep OMNILAB_EMAIL_USE_TLS=false when this is true.
OMNILAB_EMAIL_USE_SSL=false
# Optional SMTP connection timeout. Values are bounded to 1-8 seconds.
OMNILAB_EMAIL_TIMEOUT=8
OMNILAB_CONTACT_FROM_EMAIL=omnilab-bk8q@mail.tin.computer
OMNILAB_CONTACT_TO_EMAIL=omnilab-bk8q@mail.tin.computer

# Optional contact-form abuse limits. Defaults allow 5 valid submissions from
# one network address in each one-hour window.
OMNILAB_CONTACT_RATE_LIMIT_REQUESTS=5
OMNILAB_CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600
